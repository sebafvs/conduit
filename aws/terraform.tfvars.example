# Copy to terraform.tfvars and edit. terraform.tfvars is gitignored.
# All of these have sensible defaults in variables.tf; you only need to
# override what you actually want different.

region            = "eu-north-1"
availability_zone = "eu-north-1a"
instance_type     = "t3.micro"
ssh_key_dir       = "/root/.ssh/tf"
project_tag       = "conduit"

