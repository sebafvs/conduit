[Unit]
Description=OnionShare chat (persistent .onion for operator comms)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
ExecStart={{ onionshare_venv }}/bin/onionshare-cli --chat --persistent {{ onionshare_config }}
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
